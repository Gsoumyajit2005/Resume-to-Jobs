# Environment Configuration

# LLM API Keys
# OpenAI API Key (for OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Or use Anthropic API Key (for Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Custom LLM Endpoint (for local/Kubernetes models)
# This is the primary way to use locally hosted models
LLM_BASE_URL=http://your-k8s-cluster-ip:port/v1
LLM_API_KEY=dummy  # Required even if no auth - just needs to be non-empty

# LLM Model Name (for OpenAI-compatible endpoints)
# For local models, use the model name your server exposes
LLM_MODEL_NAME=claude-sonnet-4-6

# Application Settings
API_URL=http://localhost:8000
DEBUG=false
